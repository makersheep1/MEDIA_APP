####### Compile

main.o: main.cpp mainwindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

mainwindow.o: mainwindow.cpp mainwindow.h \
		ui_mainwindow.h \
		musicwindow.h \
		videowindow.h \
		weatherwindow.h \
		weatherdata.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o mainwindow.cpp

musicwindow.o: musicwindow.cpp musicwindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o musicwindow.o musicwindow.cpp

videowindow.o: videowindow.cpp videowindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o videowindow.o videowindow.cpp

weatherwindow.o: weatherwindow.cpp weatherwindow.h \
		weatherdata.h \
		weathertool.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o weatherwindow.o weatherwindow.cpp

qrc_pic.o: qrc_pic.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o qrc_pic.o qrc_pic.cpp

moc_mainwindow.o: moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

moc_musicwindow.o: moc_musicwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_musicwindow.o moc_musicwindow.cpp

moc_videowindow.o: moc_videowindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_videowindow.o moc_videowindow.cpp

moc_weatherwindow.o: moc_weatherwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_weatherwindow.o moc_weatherwindow.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/CAR_APP/bin || mkdir -p $(INSTALL_ROOT)/opt/CAR_APP/bin
	-$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/CAR_APP/bin/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/opt/CAR_APP/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/CAR_APP/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/CAR_APP/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

